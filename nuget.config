<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Only use stable NuGet.org feed, no previews -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Allow package downgrades when needed to resolve conflicts -->
  <config>
    <add key="allowMultipleVersionsPerPackage" value="true" />
  </config>
</configuration>
