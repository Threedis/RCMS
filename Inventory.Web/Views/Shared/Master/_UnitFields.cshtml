<div class="col-md-4">
    <label class="form-label" for="Symbol">Symbol <span class="text-danger">*</span></label>
    <input type="text" class="form-control" id="Symbol" name="Symbol" maxlength="10" required
           placeholder="Nos" />
    <div class="invalid-feedback" data-valmsg-for="Symbol"></div>
</div>
<div class="col-md-4">
    <label class="form-label" for="DecimalPlaces">Decimal Places</label>
    <select class="form-select" id="DecimalPlaces" name="DecimalPlaces">
        <option value="0">0 — whole numbers</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
    </select>
</div>
