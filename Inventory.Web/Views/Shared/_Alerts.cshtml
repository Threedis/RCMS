@*
    Renders the flash messages set by BaseController.Success / Error / Warning / Info.
    Razor HTML-encodes the message automatically, so a message that ever carried
    user input still cannot inject markup.
*@
@{
    var alerts = new (string Key, string Css, string Icon)[]
    {
        ("Success", "success", "bi-check-circle-fill"),
        ("Error",   "danger",  "bi-exclamation-octagon-fill"),
        ("Warning", "warning", "bi-exclamation-triangle-fill"),
        ("Info",    "info",    "bi-info-circle-fill")
    };
}

@foreach (var (key, css, icon) in alerts)
{
    if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@css alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
            <i class="bi @icon mt-1"></i>
            <div class="flex-grow-1">@message</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}
