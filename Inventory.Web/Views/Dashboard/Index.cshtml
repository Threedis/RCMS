@model DashboardDto
@{
    ViewData["Title"] = "Executive Dashboard";
    ViewData["Icon"] = "bi-speedometer2";
    ViewData["Subtitle"] = $"As at {DateTime.Now.ToDisplayDateTime()}";

    var k = Model.Kpis;

    string Trend(decimal percent) => percent switch
    {
        > 0 => $"<span class=\"text-danger small\"><i class=\"bi bi-arrow-up\"></i> {percent:N1}%</span>",
        < 0 => $"<span class=\"text-success small\"><i class=\"bi bi-arrow-down\"></i> {Math.Abs(percent):N1}%</span>",
        _ => "<span class=\"text-muted small\">no change</span>"
    };
}

@section PageActions {
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnRefresh">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </button>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Report" asp-action="Index">
        <i class="bi bi-file-earmark-bar-graph me-1"></i>Reports
    </a>
}

@* ---- KPI cards --------------------------------------------------------- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card kpi-card shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Inventory Value</div>
                    <div class="kpi-value" id="kpiInventoryValue">@k.TotalInventoryValue.ToMoney()</div>
                    <div class="small text-muted">@k.TotalItems.ToString("N0") items</div>
                </div>
                <i class="bi bi-cash-stack kpi-icon text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-success shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Today's Inward</div>
                    <div class="kpi-value" id="kpiTodayInward">@k.TodayInwardValue.ToMoney()</div>
                    <div class="small text-muted">@k.TodayInwardCount receipt(s)</div>
                </div>
                <i class="bi bi-box-arrow-in-down kpi-icon text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-info shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Today's Outward</div>
                    <div class="kpi-value" id="kpiTodayOutward">@k.TodayOutwardValue.ToMoney()</div>
                    <div class="small text-muted">@k.TodayOutwardCount issue(s)</div>
                </div>
                <i class="bi bi-box-arrow-up kpi-icon text-info"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-warning shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Pending Approvals</div>
                    <div class="kpi-value" id="kpiPendingApprovals">@k.PendingApprovalCount</div>
                    <a class="small" asp-controller="Approval" asp-action="Index">Review queue</a>
                </div>
                <i class="bi bi-hourglass-split kpi-icon text-warning"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-danger shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Low Stock</div>
                    <div class="kpi-value text-danger">@k.LowStockCount</div>
                    <a class="small" asp-controller="Stock" asp-action="LowStock">Items to reorder</a>
                </div>
                <i class="bi bi-exclamation-triangle kpi-icon text-danger"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card shadow-sm h-100" style="border-left-color:#6c757d;">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Dead Stock</div>
                    <div class="kpi-value">@k.DeadStockCount</div>
                    <div class="small text-muted">@k.DeadStockValue.ToMoney() held</div>
                </div>
                <i class="bi bi-archive kpi-icon text-secondary"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-purple shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Month Consumption</div>
                    <div class="kpi-value">@k.MonthConsumptionValue.ToMoney()</div>
                    <div>@Html.Raw(Trend(k.ConsumptionChangePercent)) <span class="text-muted small">vs last month</span></div>
                </div>
                <i class="bi bi-graph-down-arrow kpi-icon" style="color:#6f42c1;"></i>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card kpi-card kpi-success shadow-sm h-100">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <div class="kpi-label">Month Purchase</div>
                    <div class="kpi-value">@k.MonthPurchaseValue.ToMoney()</div>
                    <div>@Html.Raw(Trend(k.PurchaseChangePercent)) <span class="text-muted small">vs last month</span></div>
                </div>
                <i class="bi bi-graph-up-arrow kpi-icon text-success"></i>
            </div>
        </div>
    </div>
</div>

@* ---- Charts ------------------------------------------------------------ *@
<div class="row g-3 mb-3">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Inward vs Outward — last 12 months</h2>
                <span class="small text-muted">Value in @AppConstants.CurrencySymbol</span>
            </div>
            <div class="card-body">
                <div class="chart-container chart-lg">
                    <canvas id="chartTrend" aria-label="Monthly inward and outward value"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Stock value by category</h2>
            </div>
            <div class="card-body">
                <div class="chart-container chart-lg">
                    <canvas id="chartCategory" aria-label="Stock value by category"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Stock by warehouse</h2></div>
            <div class="card-body">
                <div class="chart-container"><canvas id="chartWarehouse"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Top vendors this year</h2></div>
            <div class="card-body">
                <div class="chart-container"><canvas id="chartVendors"></canvas></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><h2 class="h6 mb-0">Documents by status</h2></div>
            <div class="card-body">
                <div class="chart-container"><canvas id="chartStatus"></canvas></div>
            </div>
        </div>
    </div>
</div>

@* ---- Panels ------------------------------------------------------------ *@
<div class="row g-3">
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0"><i class="bi bi-exclamation-triangle text-danger me-1"></i>Low stock</h2>
                <a class="small" asp-controller="Stock" asp-action="LowStock">View all</a>
            </div>
            <div class="list-group list-group-flush" style="max-height:20rem;overflow-y:auto;">
                @if (Model.LowStockItems.Count == 0)
                {
                    <div class="list-group-item text-muted small text-center py-4">
                        Every item is above its reorder level.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.LowStockItems)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="me-2">
                                <div class="fw-semibold small">@item.ItemName</div>
                                <div class="text-muted" style="font-size:.72rem;">
                                    @item.ItemCode · @item.WarehouseName
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="badge bg-danger-subtle text-danger-emphasis">
                                    @item.CurrentStock.ToQuantity() @item.UnitSymbol
                                </div>
                                <div class="text-muted" style="font-size:.7rem;">
                                    reorder at @item.ReorderLevel.ToQuantity()
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0"><i class="bi bi-hourglass-split text-warning me-1"></i>Pending approvals</h2>
                <a class="small" asp-controller="Approval" asp-action="Index">Open queue</a>
            </div>
            <div class="list-group list-group-flush" style="max-height:20rem;overflow-y:auto;">
                @if (Model.PendingApprovals.Count == 0)
                {
                    <div class="list-group-item text-muted small text-center py-4">
                        Nothing is waiting for approval.
                    </div>
                }
                else
                {
                    @foreach (var doc in Model.PendingApprovals)
                    {
                        var url = doc.DocumentType == DocumentType.GoodsReceiptNote
                            ? Url.Action("Details", "Grn", new { id = doc.DocumentId })
                            : Url.Action("Details", "Issue", new { id = doc.DocumentId });

                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           href="@url">
                            <div class="me-2">
                                <div class="fw-semibold small">@doc.DocumentNumber</div>
                                <div class="text-muted" style="font-size:.72rem;">
                                    @doc.DocumentTypeName · @doc.PartyName
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="small">@doc.TotalValue.ToMoney()</div>
                                <span class="badge @(doc.AgeInDays > 3 ? "bg-danger-subtle text-danger-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">
                                    @doc.AgeInDays d
                                </span>
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0"><i class="bi bi-activity text-primary me-1"></i>Recent activity</h2>
            </div>
            <div class="list-group list-group-flush" style="max-height:20rem;overflow-y:auto;">
                @if (Model.RecentActivities.Count == 0)
                {
                    <div class="list-group-item text-muted small text-center py-4">No recent activity.</div>
                }
                else
                {
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="list-group-item d-flex gap-2">
                            <i class="bi @(activity.Icon ?? "bi-activity") text-primary mt-1"></i>
                            <div class="flex-grow-1">
                                <div class="small">@activity.Description</div>
                                <div class="text-muted" style="font-size:.7rem;">
                                    @activity.UserName · @activity.ActivityOn.ToDisplayDateTime()
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // The server already computed every series; the view only draws it.
            const data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                trend = Model.MonthlyTrend.Select(t => new { t.MonthLabel, t.InwardValue, t.OutwardValue }),
                category = Model.StockByCategory.Select(c => new { c.Label, c.Value }),
                warehouse = Model.StockByWarehouse.Select(w => new { w.Label, w.Value }),
                vendors = Model.TopVendors.Select(v => new { v.Label, v.Value }),
                status = Model.DocumentStatusSplit.Select(s => new { s.Label, s.Value })
            }, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }));

            inv.chart.line('chartTrend',
                data.trend.map(t => t.monthLabel),
                [
                    { label: 'Inward', data: data.trend.map(t => t.inwardValue) },
                    { label: 'Outward', data: data.trend.map(t => t.outwardValue) }
                ]);

            inv.chart.doughnut('chartCategory',
                data.category.map(c => c.label),
                data.category.map(c => c.value));

            inv.chart.bar('chartWarehouse',
                data.warehouse.map(w => w.label),
                data.warehouse.map(w => w.value),
                'Stock value', true);

            inv.chart.bar('chartVendors',
                data.vendors.map(v => v.label),
                data.vendors.map(v => v.value),
                'Purchase value', true);

            inv.chart.doughnut('chartStatus',
                data.status.map(s => s.label),
                data.status.map(s => s.value));

            $('#btnRefresh').on('click', function () {
                const $button = $(this).prop('disabled', true);

                inv.get('/Dashboard/Data').then(function (response) {
                    $button.prop('disabled', false);

                    if (!response.success) {
                        inv.toast(response.message, 'danger');
                        return;
                    }

                    const kpis = response.data.kpis;
                    $('#kpiInventoryValue').text('₹' + inv.format.money(kpis.totalInventoryValue));
                    $('#kpiTodayInward').text('₹' + inv.format.money(kpis.todayInwardValue));
                    $('#kpiTodayOutward').text('₹' + inv.format.money(kpis.todayOutwardValue));
                    $('#kpiPendingApprovals').text(kpis.pendingApprovalCount);

                    inv.toast('Dashboard refreshed.', 'success');
                });
            });
        })();
    </script>
}
