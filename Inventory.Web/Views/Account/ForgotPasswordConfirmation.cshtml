@{
    ViewData["Title"] = "Request received";
}

<div class="text-center">
    <i class="bi bi-check-circle display-5 text-success"></i>
    <h2 class="h6 mt-3">Request received</h2>
    <p class="text-muted small">
        If the address you entered belongs to an active account, your administrator
        has been notified and will issue a new password.
    </p>
    <a asp-action="Login" class="btn btn-primary w-100">Back to sign in</a>
</div>
