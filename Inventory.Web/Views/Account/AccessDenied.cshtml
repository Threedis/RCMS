@{
    ViewData["Title"] = "Access denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Icon"] = "bi-shield-exclamation";
}

<div class="card shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-shield-lock display-4 text-danger"></i>
        <h2 class="h5 mt-3">You do not have permission to view this page</h2>
        <p class="text-muted">
            Your account does not hold a role that grants access to this area.
            Contact your administrator if you believe this is a mistake.
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-speedometer2 me-1"></i>Back to the dashboard
        </a>
    </div>
</div>
