@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<h2 class="h6 mb-3">Reset your password</h2>
<p class="text-muted small">
    Enter your registered e-mail address. If it matches an active account, your
    administrator will be asked to issue a new password.
</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" required autofocus />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Send request</button>
    <a asp-action="Login" class="btn btn-link w-100 mt-2">Back to sign in</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
