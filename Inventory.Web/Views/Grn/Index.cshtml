@model MasterDto
@{
    ViewData["Title"] = "Goods Receipt Notes";
    ViewData["Icon"] = "bi-box-arrow-in-down";
    ViewData["Subtitle"] = "Incoming goods and receipts";

    var canApprove = User.IsInRole(Roles.Approver) || User.IsInRole(Roles.Administrator);
    var canManage = User.IsInRole(Roles.InventoryManager) || User.IsInRole(Roles.Administrator);
}

@section PageActions {
    <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-format="excel">
        <i class="bi bi-file-earmark-excel me-1"></i>Excel
    </a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Export" asp-route-format="pdf">
        <i class="bi bi-file-earmark-pdf me-1"></i>PDF
    </a>
    @if (canManage)
    {
        <button type="button" class="btn btn-primary btn-sm" id="btnCreate">
            <i class="bi bi-plus-lg me-1"></i>New GRN
        </button>
    }
}

@Html.Partial("~/Views/Shared/_FilterPanel.cshtml",
    new FilterViewModel { VisibleFilters = new[] { "dateRange", "vendor", "warehouse", "status" } })

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-sm align-middle w-100" id="grnGrid">
            <thead class="table-light">
                <tr>
                    <th style="width:10rem;">GRN No.</th>
                    <th>Vendor</th>
                    <th class="d-none d-md-table-cell">Warehouse</th>
                    <th class="text-end">Qty (lines)</th>
                    <th class="text-end">Total Value</th>
                    <th>Status</th>
                    <th style="width:6rem;">Inward</th>
                    <th class="text-end" style="width:8rem;">Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const canManage = @canManage.ToString().ToLowerInvariant();
            const canApprove = @canApprove.ToString().ToLowerInvariant();

            const grid = inv.grid('#grnGrid', {
                url: '/Grn/List',
                columns: [
                    { data: 'grnNumber' },
                    { data: 'vendorName' },
                    { data: 'warehouseName', className: 'd-none d-md-table-cell' },
                    { data: 'lineCount', className: 'text-end', render: inv.render.integer },
                    { data: 'totalValue', className: 'text-end', render: inv.render.money },
                    { data: 'status', orderable: false, render: inv.render.documentStatus },
                    {
                        data: 'inwardDate',
                        orderable: false,
                        render: function (date) {
                            return date ? inv.render.date(date) : '<span class="text-muted">—</span>';
                        }
                    },
                    {
                        data: 'id',
                        orderable: false,
                        className: 'text-end',
                        render: function (id, type, row) {
                            let actions = `<a href="/Grn/Details/${id}" class="btn btn-sm btn-link p-1" title="View"><i class="bi bi-eye"></i></a>`;
                            if (canManage && (row.status === 'Draft' || row.status === 'Rejected')) {
                                actions += ` <a href="/Grn/Edit/${id}" class="btn btn-sm btn-link p-1" title="Edit"><i class="bi bi-pencil"></i></a>`;
                                actions += ` <button type="button" class="btn btn-sm btn-link p-1 text-danger js-delete" data-id="${id}" title="Delete"><i class="bi bi-trash"></i></button>`;
                            }
                            if (row.status === 'Draft' && canManage) {
                                actions += ` <button type="button" class="btn btn-sm btn-link p-1 text-primary js-submit" data-id="${id}" title="Submit"><i class="bi bi-arrow-right"></i></button>`;
                            }
                            if (row.status === 'PendingApproval' && canApprove) {
                                actions += ` <button type="button" class="btn btn-sm btn-link p-1 text-success js-approve" data-id="${id}" title="Approve"><i class="bi bi-check2"></i></button>`;
                            }
                            return actions;
                        }
                    }
                ],
                order: [[0, 'desc']]
            });

            $('#btnCreate').on('click', function () {
                window.location.href = '/Grn/Create';
            });

            $('#grnGrid').on('click', '.js-submit', function () {
                const id = $(this).data('id');
                inv.confirm('Submit for approval?', 'Once submitted, the GRN cannot be edited.')
                    .then(ok => {
                        if (!ok) return;
                        inv.post('/Grn/Submit', { id }).then(response => {
                            inv.toast(response.message, response.success ? 'success' : 'danger');
                            if (response.success) grid.ajax.reload(null, false);
                        });
                    });
            });

            $('#grnGrid').on('click', '.js-approve', function () {
                window.location.href = '/Grn/Details/' + $(this).data('id');
            });

            $('#grnGrid').on('click', '.js-delete', function () {
                const id = $(this).data('id');
                inv.confirm('Delete this GRN?', 'The record will be soft-deleted for history.')
                    .then(ok => {
                        if (!ok) return;
                        inv.post('/Grn/Delete', { id }).then(response => {
                            inv.toast(response.message, response.success ? 'success' : 'danger');
                            if (response.success) grid.ajax.reload(null, false);
                        });
                    });
            });

            // Filter apply
            $('#filterApply').on('click', function () {
                const filters = {
                    fromDate: $('#filterFromDate').val(),
                    toDate: $('#filterToDate').val(),
                    vendorId: $('#filterVendor').val(),
                    warehouseId: $('#filterWarehouse').val(),
                    status: $('#filterStatus').val()
                };
                grid.settings().ajax.data = function () { return filters; };
                grid.ajax.reload();
            });

            $('#filterReset').on('click', function () {
                $('#filterFromDate, #filterToDate, #filterVendor, #filterWarehouse, #filterStatus').val('').trigger('change');
                grid.settings().ajax.data = function () { return {}; };
                grid.ajax.reload();
            });
        })();
    </script>
}
