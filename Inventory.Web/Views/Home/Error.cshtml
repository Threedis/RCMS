@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = User.Identity?.IsAuthenticated == true ? "~/Views/Shared/_Layout.cshtml" : null;
}

@if (User.Identity?.IsAuthenticated != true)
{
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
}

<div class="card shadow-sm">
    <div class="card-body text-center py-5">
        <div class="display-1 fw-bold text-muted">@Model.StatusCode</div>
        <h1 class="h4 mt-2">@Model.Title</h1>
        <p class="text-muted">@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">
                Reference: <code>@Model.RequestId</code><br />
                Quote this reference when contacting support.
            </p>
        }

        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>Back to the dashboard
        </a>
    </div>
</div>
